{
  "permissions": {
    "allow": [
      "Shell(bun:*)",
      "Shell(git:*)",
      "Shell(agent-browser:*)",
      "Shell(curl -s --max-time 20 https://reviewkit.gutensuite.net/docs/)",
      "Shell(curl -s -o /dev/null -w /features/ -> %{http_code}\\n --max-time 20 https://reviewkit.gutensuite.net/features/)",
      "Shell(curl -sI --max-time 20 http://reviewkit.gutensuite.net/)",
      "Shell(curl -sI --max-time 20 https://www.reviewkit.gutensuite.net/ 2 >& 1)",
      "Shell(curl -sI --max-time 20 https://reviewkit.gutensuite.net/)",
      "Shell(curl -s --max-time 30 https://reviewkit.gutensuite.net/)",
      "Shell(curl -s -o /dev/null -w %{http_code}\\n --max-time 20 https://reviewkit.gutensuite.net/docs.html)",
      "Shell(curl -s --max-time 20 https://reviewkit.gutensuite.net/features/)",
      "Shell(curl -sL -o /dev/null -w final: %{http_code} %{url_effective}\\n --max-time 20 https://reviewkit.gutensuite.net/docs)",
      "Shell(curl -s -o /tmp/inst.html -w %{http_code} %{content_type}\\n --max-time 20 https://reviewkit.gutensuite.net/docs/installation)",
      "Shell(grep:*)",
      "Shell(for:*)",
      "Shell(do:*)",
      "Shell(done:*)",
      "Shell(mkdir:*)",
      "Shell(cp:*)",
      "Shell(head -8 app/features/page.js app/showcase/page.js app/pricing/page.js app/changelog/page.js app/contact/page.js app/docs/page.js app/docs/installation/page.js 2>/dev/null; ls app app/docs public lib components)",
      "Shell(npm:*)",
      "Shell(test:*)",
      "Shell(for f in index features showcase pricing changelog contact docs docs/installation; do echo \"$f: $(grep -o '<meta name=\"description\" content=\"[^\"]*\"' out/$f.html | head -1 | cut -c1-90)\"; done)",
      "Shell(sips:*)",
      "Shell(node -e JSON.parse(require('fs').readFileSync('data.json','utf8')); console.log('valid JSON'))"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}